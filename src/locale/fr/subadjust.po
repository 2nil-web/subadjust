msgid "Save your file and exit from the app.\nAvailable shortcut is 'Ctrl-X'."
msgstr "Enregistre le fichier et quitte l'application.\nRaccourci disponible « Ctrl-X »."

msgid "Some useful informations about the app (Shortcut Ctrl+B)."
msgstr "Informations sur l'application (Raccourci Ctrl+B)."

